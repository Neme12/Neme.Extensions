<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>$(NoWarn);RS1035</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>

    <!-- Avoid ID conflicts with the package project. -->
    <PackageId>*$(MSBuildProjectFile)*</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neme.Extensions.SourceGenerators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Neme.Extensions.InterpolatedString" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Neme.Polyfills\Neme.Polyfills\Neme.Polyfills.csproj">
      <IncludeInVSIX>true</IncludeInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Neme.Extensions.Core\Neme.Extensions\InterpolatedString.cs" Link="Linked\InterpolatedString.cs" />
    <Compile Include="..\..\Neme.Extensions.Core\Neme.Extensions\CompilerServices\InvariantInterpolatedStringHandler.cs" Link="Linked\CompilerServices\InvariantInterpolatedStringHandler.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\Neme.Extensions.SourceGenerators.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

</Project>
